# SlothAI Local FastAPI Backend Configuration
# Copy this file to .env inside the backend/ directory if customizing settings.

# Bind host and port (Default to localhost 127.0.0.1 for local-first security)
SLOTHAI_BACKEND_HOST=127.0.0.1
SLOTHAI_BACKEND_PORT=8000

# Allowed frontend CORS origins (comma-separated, never wildcard *)
SLOTHAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Local Ollama service configuration
SLOTHAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
SLOTHAI_DEFAULT_MODEL=qwen3:4b
SLOTHAI_OLLAMA_TIMEOUT_SECONDS=90

# Upload and text length limits
SLOTHAI_MAX_UPLOAD_BYTES=5242880
SLOTHAI_MAX_INPUT_CHARS=60000

# Optional: Explicitly approved root directory for File Organizer apply operations.
# Leave empty to keep filesystem modifications disabled (suggestions-only mode).
# Example on Windows: C:\Users\YourName\Documents\SlothAI_Workspace
SLOTHAI_ALLOWED_ORGANIZE_ROOT=
