# ============================================================================
# SlothAI Local-First Configuration (.env.example)
# No cloud AI API keys or external secrets are required for SlothAI features.
# ============================================================================

# Frontend -> Local Backend URL (used by Vite frontend when running locally)
# Leave empty in unified dev server mode to use relative '/api' routes,
# or set to http://127.0.0.1:8000 when running the standalone FastAPI server.
VITE_BACKEND_URL=""

# FastAPI / Local Backend Host & Port (Default: 127.0.0.1:8000)
SLOTHAI_BACKEND_HOST="127.0.0.1"
SLOTHAI_BACKEND_PORT="8000"

# Allowed CORS Origins (comma-separated, never wildcard *)
SLOTHAI_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Local Ollama Instance URL & Default Open-Weight Model Suggestion
SLOTHAI_OLLAMA_BASE_URL="http://127.0.0.1:11434"
SLOTHAI_DEFAULT_MODEL="qwen3:4b"
SLOTHAI_OLLAMA_TIMEOUT_SECONDS="90"

# Request and File Upload Limits
SLOTHAI_MAX_UPLOAD_BYTES="5242880"
SLOTHAI_MAX_INPUT_CHARS="60000"

# Explicitly Approved Root Directory for File Organizer Apply Operations
# Must be configured explicitly to allow moving/renaming local files.
# Leave empty to keep filesystem modifications disabled (suggestions-only mode).
SLOTHAI_ALLOWED_ORGANIZE_ROOT=""
