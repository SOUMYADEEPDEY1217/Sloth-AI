{
  "entities": {
    "UserWorkspaceProfile": {
      "title": "UserWorkspaceProfile",
      "description": "Per-user workspace preferences and local AI engine configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the authenticated user who owns this workspace profile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "backendUrl": {
          "type": "string",
          "description": "Configured FastAPI backend base URL.",
          "minLength": 0,
          "maxLength": 300
        },
        "ollamaBaseUrl": {
          "type": "string",
          "description": "Configured local Ollama service URL.",
          "minLength": 1,
          "maxLength": 300
        },
        "modelName": {
          "type": "string",
          "description": "Selected open-weight model tag.",
          "minLength": 1,
          "maxLength": 120
        },
        "theme": {
          "type": "string",
          "description": "Selected UI theme.",
          "enum": ["dark", "light"],
          "maxLength": 16
        },
        "defaultSummaryLength": {
          "type": "string",
          "description": "Default summary length preference.",
          "enum": ["short", "balanced", "detailed"],
          "maxLength": 16
        },
        "retainActivityLog": {
          "type": "boolean",
          "description": "Whether to persist activity log entries."
        },
        "maxActivityEntries": {
          "type": "number",
          "description": "Maximum number of retained activity entries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "backendUrl",
        "ollamaBaseUrl",
        "modelName",
        "theme",
        "defaultSummaryLength",
        "retainActivityLog",
        "maxActivityEntries",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserTask": {
      "title": "UserTask",
      "description": "An action item or extracted task belonging to a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this task.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Task title.",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Task description or context.",
          "minLength": 0,
          "maxLength": 2000
        },
        "deadline": {
          "type": "string",
          "description": "Explicit deadline text or empty string if none.",
          "minLength": 0,
          "maxLength": 160
        },
        "priority": {
          "type": "string",
          "description": "Task priority level.",
          "enum": ["high", "medium", "low", "unspecified"],
          "maxLength": 20
        },
        "prioritySource": {
          "type": "string",
          "description": "Whether priority was explicit, inferred, or none.",
          "enum": ["explicit", "inferred", "none"],
          "maxLength": 20
        },
        "sourceEvidence": {
          "type": "string",
          "description": "Source quote supporting the task.",
          "minLength": 0,
          "maxLength": 600
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is marked complete."
        },
        "sourceOrigin": {
          "type": "string",
          "description": "Origin of the task.",
          "enum": ["live-ollama", "manual", "demo-sample"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the task was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the task was last updated."
        }
      },
      "required": [
        "ownerId",
        "title",
        "description",
        "deadline",
        "priority",
        "prioritySource",
        "sourceEvidence",
        "completed",
        "sourceOrigin",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserStagedFile": {
      "title": "UserStagedFile",
      "description": "A staged file organization suggestion belonging to a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this staged file record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "originalName": {
          "type": "string",
          "description": "Original filename.",
          "minLength": 1,
          "maxLength": 260
        },
        "sourceRelativePath": {
          "type": "string",
          "description": "Original relative path.",
          "minLength": 1,
          "maxLength": 400
        },
        "extension": {
          "type": "string",
          "description": "File extension.",
          "minLength": 0,
          "maxLength": 32
        },
        "sizeBytes": {
          "type": "number",
          "description": "File size in bytes."
        },
        "suggestedCategory": {
          "type": "string",
          "description": "Suggested category label.",
          "minLength": 1,
          "maxLength": 100
        },
        "suggestedFolder": {
          "type": "string",
          "description": "Suggested destination folder.",
          "minLength": 1,
          "maxLength": 260
        },
        "suggestedFilename": {
          "type": "string",
          "description": "Suggested kebab-case filename.",
          "minLength": 1,
          "maxLength": 260
        },
        "reasoning": {
          "type": "string",
          "description": "Explanation for the organization suggestion.",
          "minLength": 0,
          "maxLength": 600
        },
        "approved": {
          "type": "boolean",
          "description": "Whether the user approved this file operation."
        },
        "status": {
          "type": "string",
          "description": "Staging status.",
          "enum": ["pending", "preview-validated", "applied"],
          "maxLength": 32
        },
        "isDemoData": {
          "type": "boolean",
          "description": "Whether this item comes from static demo data."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the record was last updated."
        }
      },
      "required": [
        "ownerId",
        "originalName",
        "sourceRelativePath",
        "extension",
        "sizeBytes",
        "suggestedCategory",
        "suggestedFolder",
        "suggestedFilename",
        "reasoning",
        "approved",
        "status",
        "isDemoData",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserSummary": {
      "title": "UserSummary",
      "description": "A generated document summary belonging to a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this summary.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Summary title.",
          "minLength": 1,
          "maxLength": 300
        },
        "executiveSummary": {
          "type": "string",
          "description": "Main executive summary paragraph.",
          "minLength": 1,
          "maxLength": 5000
        },
        "keyPointsText": {
          "type": "string",
          "description": "Newline-separated key takeaways.",
          "minLength": 0,
          "maxLength": 4000
        },
        "notableTermsText": {
          "type": "string",
          "description": "Newline-separated notable terms.",
          "minLength": 0,
          "maxLength": 1000
        },
        "uncertaintyNotes": {
          "type": "string",
          "description": "Optional uncertainty notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "length": {
          "type": "string",
          "description": "Summary length preset.",
          "enum": ["short", "balanced", "detailed"],
          "maxLength": 16
        },
        "sourceWordCount": {
          "type": "number",
          "description": "Word count of source document."
        },
        "summaryWordCount": {
          "type": "number",
          "description": "Word count of summary."
        },
        "sourceType": {
          "type": "string",
          "description": "Execution mode.",
          "enum": ["live-ollama", "sample-preview"],
          "maxLength": 24
        },
        "modelUsed": {
          "type": "string",
          "description": "Model name used.",
          "minLength": 1,
          "maxLength": 120
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO timestamp when summary was generated.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when saved."
        }
      },
      "required": [
        "ownerId",
        "title",
        "executiveSummary",
        "keyPointsText",
        "notableTermsText",
        "uncertaintyNotes",
        "length",
        "sourceWordCount",
        "summaryWordCount",
        "sourceType",
        "modelUsed",
        "generatedAt",
        "createdAt"
      ]
    },
    "UserBriefing": {
      "title": "UserBriefing",
      "description": "A generated daily briefing belonging to a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this briefing.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conciseSummary": {
          "type": "string",
          "description": "Concise executive overview.",
          "minLength": 1,
          "maxLength": 4000
        },
        "importantInfoText": {
          "type": "string",
          "description": "Newline-separated important facts.",
          "minLength": 0,
          "maxLength": 4000
        },
        "actionItemsText": {
          "type": "string",
          "description": "Newline-separated action items.",
          "minLength": 0,
          "maxLength": 4000
        },
        "deadlinesText": {
          "type": "string",
          "description": "Newline-separated item and deadline pairs.",
          "minLength": 0,
          "maxLength": 2000
        },
        "questionsText": {
          "type": "string",
          "description": "Newline-separated follow-up questions.",
          "minLength": 0,
          "maxLength": 2000
        },
        "sourceMode": {
          "type": "string",
          "description": "Source execution mode.",
          "enum": ["live-ollama", "demo-sample"],
          "maxLength": 24
        },
        "modelUsed": {
          "type": "string",
          "description": "Model name used.",
          "minLength": 1,
          "maxLength": 120
        },
        "inputWordCount": {
          "type": "number",
          "description": "Word count of input notes."
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO timestamp when briefing was generated.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when saved."
        }
      },
      "required": [
        "ownerId",
        "conciseSummary",
        "importantInfoText",
        "actionItemsText",
        "deadlinesText",
        "questionsText",
        "sourceMode",
        "modelUsed",
        "inputWordCount",
        "generatedAt",
        "createdAt"
      ]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "An activity log entry belonging to a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this activity entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Activity type.",
          "enum": [
            "summarize",
            "extract_tasks",
            "organize_files",
            "daily_briefing",
            "connection_test",
            "model_pull",
            "settings_update",
            "system"
          ],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Activity status outcome.",
          "enum": ["success", "warning", "error", "info"],
          "maxLength": 16
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the action.",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceMode": {
          "type": "string",
          "description": "Source execution mode.",
          "enum": ["live-ollama", "demo-sample", "system"],
          "maxLength": 24
        },
        "timestampIso": {
          "type": "string",
          "description": "ISO timestamp string for UI display.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the activity was logged."
        }
      },
      "required": [
        "ownerId",
        "type",
        "status",
        "description",
        "sourceMode",
        "timestampIso",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspaceProfile" },
      "description": "Stores each authenticated user's workspace settings and profile."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/UserTask" },
      "description": "Stores each authenticated user's individual tasks."
    },
    "/users/{userId}/stagedFiles/{fileId}": {
      "schema": { "$ref": "#/entities/UserStagedFile" },
      "description": "Stores each authenticated user's individual staged file organization items."
    },
    "/users/{userId}/summaries/{summaryId}": {
      "schema": { "$ref": "#/entities/UserSummary" },
      "description": "Stores each authenticated user's individual generated document summaries."
    },
    "/users/{userId}/briefings/{briefingId}": {
      "schema": { "$ref": "#/entities/UserBriefing" },
      "description": "Stores each authenticated user's individual generated daily briefings."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/UserActivity" },
      "description": "Stores each authenticated user's individual workspace activity log entries."
    }
  }
}
